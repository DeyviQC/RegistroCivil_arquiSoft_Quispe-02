APP_NAME="Sistema Registro Civil"
# Valores de DESARROLLO. Para cualquier despliegue usa: APP_ENV=production, APP_DEBUG=false,
# LOG_LEVEL=warning, SESSION_SECURE_COOKIE=true, SESSION_ENCRYPT=true y revisa con: php artisan sistema:verificar
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# Con Laravel Herd, el sitio "parkeado" queda disponible automáticamente en
# http://registro-civil.test (ajusta si usas otro nombre de carpeta).
APP_URL=http://registro-civil.test

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_PE

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
# DBngin expone MySQL 9.7 en 127.0.0.1:3306 con root sin contraseña por defecto.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=registro_civil
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
# En producción (HTTPS): APP_ENV=production, APP_DEBUG=false,
# SESSION_SECURE_COOKIE=true y SESSION_ENCRYPT=true.
SESSION_SECURE_COOKIE=
SESSION_ENCRYPT=false

CACHE_STORE=file
# sync: los correos se envían al momento (cómodo en desarrollo).
# database (recomendado): los avisos se envían en segundo plano con reintentos;
# los procesa schedule:run cada minuto (scripts/windows/registrar-tareas.ps1).
QUEUE_CONNECTION=database

# Respaldos (php artisan respaldo:crear). Usar OTRO disco en producción.
RESPALDO_RUTA=
RESPALDO_DIAS_BD=14
RESPALDO_MYSQLDUMP=mysqldump
# Mínimo 12 caracteres. Guárdala fuera del equipo: descifra la copia de APP_KEY (php artisan respaldo:clave).
RESPALDO_FRASE=

# Solo para pruebas de carga con k6 (AC01/AC03): mínimo 16 caracteres; vacío el resto del tiempo.
# Las peticiones con la cabecera X-Prueba-Carga igual a este valor omiten los límites de intentos. Ignorado en producción.
PRUEBAS_CARGA_TOKEN=
# Días sin iniciar el pago antes de vencer una solicitud del portal.
PORTAL_DIAS_PARA_PAGAR=7

FILESYSTEM_DISK=local

MAIL_MAILER=log

# Tamaño máximo permitido para PDFs subidos (KB)
ACTAS_PDF_MAX_KB=10240
#api reniec

# Opcional: bundle local de autoridades certificadoras confiables para HTTPS.
PORTAL_HTTP_CA_FILE=

# Mercado Pago Checkout Pro - pruebas (no pegar secretos en el chat)
MERCADOPAGO_MODE=test
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
MERCADOPAGO_COLLECTOR_ID=
MERCADOPAGO_PUBLIC_URL=


# Python con pypdf y reportlab para colocar el logo sobre una copia del acta.
FIRMA_PYTHON=python
# Días que una copia firmada del acta se puede volver a entregar sin firmar (0 = sin límite).
FIRMA_VIGENCIA_COPIA_DIAS=90
# Archivo institucional de PCM guardado fuera de public/ y del repositorio.
FIRMAPERU_CREDENTIALS_FILE=
FIRMAPERU_PORT=48596

# Contacto público para consultas manuales: código de país y número, solo dígitos.
PORTAL_WHATSAPP_CONTACTO=

MERCADOPAGO_PUBLIC_KEY=
